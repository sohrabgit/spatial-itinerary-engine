# Copy to .env and adjust. Every value here has a working default in compose.

# ---- Inference -------------------------------------------------------------
# Ollama runs NATIVELY on the host on macOS: Docker Desktop has no Metal GPU
# passthrough, so a containerised model would be CPU-only and ~10x slower.
# See docs/adr/0003-host-native-ollama.md

# macOS (default): host-native Ollama, Metal GPU
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Linux + NVIDIA: containerised Ollama with GPU passthrough
#   docker compose --profile gpu up -d ollama
# OLLAMA_BASE_URL=http://ollama:11434

# Remote / shared inference host
# OLLAMA_BASE_URL=http://10.0.0.42:11434

OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Changing the embed model is a MIGRATION, not a config change: `make verify`
# asserts this against the poi_embedding column and fails loudly on mismatch.
# A silent dimension mismatch yields garbage similarity scores, not an error.
OLLAMA_EMBED_DIM=768

# ---- Data ------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=itinerary
POSTGRES_PORT=5432
REDIS_PORT=6379
# 5001 because macOS AirPlay Receiver holds 5000
OSRM_PORT=5001

# ---- Region ----------------------------------------------------------------
# Paris intra-muros plus margin. Clipping the 337MB Ile-de-France extract to
# this bbox cuts OSRM prep time, peak memory, POI count and disk simultaneously.
OSM_REGION_URL=https://download.geofabrik.de/europe/france/ile-de-france-latest.osm.pbf
OSM_BBOX=2.20,48.79,2.47,48.92

# ---- Frontend --------------------------------------------------------------
# Tile source sits behind this seam so swapping to self-hosted PMTiles is a
# config change, not a code change. See docs/adr/0009-map-tiles.md
NEXT_PUBLIC_TILE_KIND=raster
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_TILE_MAXZOOM=19

# ---- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
GRAFANA_PORT=3001
